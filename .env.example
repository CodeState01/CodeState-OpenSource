HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# URL HTTPS pública usada nos links de convite. Deixe vazia no uso local.
PUBLIC_APP_URL=
NODE_ENV=development
# A chave fica apenas no servidor. Não coloque chaves no código do navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Somente contas cadastradas podem consumir a API paga por padrão.
ALLOW_GUEST_AI=false
AI_DAILY_LIMIT=30
# Configure um servidor TURN para chamadas entre redes restritas.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Diretório persistente; nunca publique seu conteúdo no GitHub.
DATA_DIR=./data
# Conta administrativa global. Gere o hash com `node scripts/generate-creator-credentials.mjs`.
# Guarde a senha somente em um gerenciador de senhas e configure o hash no provedor.
CREATOR_USERNAME=
CREATOR_PASSWORD_HASH=
CREATOR_NAME=CodeState Creator
MAX_UPLOAD_MB=100
MAX_USER_STORAGE_MB=1024
